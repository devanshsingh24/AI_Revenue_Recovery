RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_DRY_RUN=true
MODEL_PATH=models/recovery_catboost.cbm
LOCAL_WEBHOOK_URL=http://127.0.0.1:8000/webhooks/razorpay
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE
DEMO_DATABASE_URL=sqlite:///./demo_revenue_recovery.db
# Frontend -> backend wiring. Set API_BASE_URL (preferred) or
# DASHBOARD_API_BASE_URL to the deployed Render URL, e.g.
# https://<service>.onrender.com. Leave unset for local dev (127.0.0.1:8001).
API_BASE_URL=
DASHBOARD_API_BASE_URL=
# Streamlit demo toggle (Streamlit Cloud secrets / local env only).
DEMO_MODE=true
